APP_NAME=IndiaTrace API
API_PREFIX=/api/v1
DATABASE_PATH=./data/indiatrace.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TINYFISH_API_KEY=replace-with-your-TinyFish-key
GEOCODER_USER_AGENT=INDIA-TRACE/0.1 (Team Tech Titans hackathon)
# Scheduled collection: 0 = off; otherwise run the pilot searches every N minutes (Search and Fetch are free within TinyFish's daily limits).
COLLECTION_INTERVAL_MINUTES=0
COLLECTION_WINDOW_DAYS=30
# Region from app/regions.py: places, roads, searches, allowed source categories, freshness windows.
REGION=northeast
# Mappls (MapmyIndia) Web Maps static key from https://auth.mappls.com/console. The map SDK runs in the browser,
# so the dashboard receives this key: restrict it to your site's domains in the Mappls console.
# Leave empty to use OpenStreetMap tiles.
MAPPLS_STATIC_KEY=
# NHAI's list of toll plazas as CSV (download "State, PIU, NHAI Regional Office wise List of NHAI Toll Plazas"
# from dataful.in/datasets/21597). Without it, routes show tolls as unknown. It has no prices.
TOLL_PLAZAS_PATH=./data/toll_plazas.csv
